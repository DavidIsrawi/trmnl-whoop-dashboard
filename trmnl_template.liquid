<style>
    :root {
        --ink: #000000;
        --paper: #ffffff;
        --muted: #555555;
        --line: #b8b8b8;
        --track: #dedede;
    }

    .whoop-dashboard {
        width: 780px;
        height: 460px;
        padding: 12px;
        overflow: hidden;
        display: grid;
        grid-template-rows: 36px 304px 80px;
        gap: 8px;
        box-sizing: border-box;
        background: var(--paper);
        color: var(--ink);
        font-family: Arial, Helvetica, sans-serif;
        font-variant-numeric: tabular-nums;
        -webkit-font-smoothing: antialiased;
    }

    .whoop-dashboard *,
    .whoop-dashboard *::before,
    .whoop-dashboard *::after {
        box-sizing: border-box;
        min-width: 0;
        margin: 0;
        padding: 0;
    }

    .whoop-dashboard .truncate {
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .whoop-dashboard .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 4px;
        overflow: hidden;
    }

    .whoop-dashboard .logo {
        flex: 0 0 auto;
        font-size: 22px;
        font-weight: 900;
        line-height: 24px;
        letter-spacing: 4px;
    }

    .whoop-dashboard .sync-meta {
        max-width: 360px;
        font-size: 12px;
        font-weight: 800;
        line-height: 16px;
        letter-spacing: 0.4px;
        text-align: right;
        text-transform: uppercase;
    }

    .whoop-dashboard .main-grid {
        display: grid;
        grid-template-columns: 468px 276px;
        gap: 12px;
        overflow: hidden;
    }

    .whoop-dashboard .card {
        overflow: hidden;
        border: 2px solid var(--ink);
        border-radius: 14px;
        background: var(--paper);
    }

    .whoop-dashboard .section-label {
        overflow: hidden;
        font-size: 13px;
        font-weight: 900;
        line-height: 16px;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .whoop-dashboard .recovery-card {
        display: grid;
        grid-template-rows: 16px 126px 1fr;
        padding: 18px 20px;
    }

    .whoop-dashboard .recovery-summary {
        display: grid;
        grid-template-columns: 210px 1fr;
        gap: 18px;
        align-items: center;
        overflow: hidden;
    }

    .whoop-dashboard .hero-value,
    .whoop-dashboard .support-value {
        overflow: hidden;
        font-weight: 900;
        letter-spacing: -0.04em;
        white-space: nowrap;
    }

    .whoop-dashboard .hero-value {
        font-size: 84px;
        line-height: 86px;
    }

    .whoop-dashboard .hero-value .unit {
        margin-left: 2px;
        font-size: 24px;
        letter-spacing: -0.02em;
    }

    .whoop-dashboard .recovery-copy {
        position: relative;
        display: flex;
        min-height: 82px;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        padding-left: 18px;
        overflow: hidden;
    }

    .whoop-dashboard .recovery-copy::before {
        position: absolute;
        top: 4px;
        bottom: 4px;
        left: 0;
        width: 1px;
        background: var(--ink);
        content: "";
    }

    .whoop-dashboard .recovery-status {
        font-size: 18px;
        font-weight: 900;
        line-height: 22px;
        letter-spacing: 0.3px;
        text-transform: uppercase;
    }

    .whoop-dashboard .recovery-guidance {
        font-size: 15px;
        font-weight: 800;
        line-height: 18px;
    }

    .whoop-dashboard .comparison {
        color: var(--muted);
        font-size: 12px;
        font-weight: 800;
        line-height: 16px;
        text-transform: uppercase;
    }

    .whoop-dashboard .trend {
        display: grid;
        grid-template-rows: 18px 70px;
        gap: 8px;
        padding-top: 12px;
        overflow: hidden;
        border-top: 1px solid var(--line);
    }

    .whoop-dashboard .trend-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        overflow: hidden;
        font-size: 12px;
        font-weight: 900;
        line-height: 16px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .whoop-dashboard .trend-heading .muted {
        color: var(--muted);
    }

    .whoop-dashboard .history-bars {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(0, 1fr);
        align-items: end;
        gap: 8px;
        height: 70px;
        overflow: hidden;
    }

    .whoop-dashboard .bar-column {
        display: grid;
        grid-template-rows: 54px 12px;
        gap: 4px;
        align-items: end;
        height: 70px;
        overflow: hidden;
    }

    .whoop-dashboard .bar-track {
        display: flex;
        width: 100%;
        height: 54px;
        align-items: flex-end;
        overflow: hidden;
        background: var(--track);
    }

    .whoop-dashboard .bar {
        width: 100%;
        background: var(--muted);
    }

    .whoop-dashboard .bar-column.today .bar {
        background: var(--ink);
    }

    .whoop-dashboard .bar-caption {
        overflow: hidden;
        font-size: 9px;
        font-weight: 900;
        line-height: 12px;
        text-align: center;
        text-overflow: clip;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .whoop-dashboard .support-column {
        display: grid;
        grid-template-rows: 146px 146px;
        gap: 12px;
        overflow: hidden;
    }

    .whoop-dashboard .support-card {
        display: grid;
        grid-template-rows: 16px 1fr 22px;
        padding: 14px 16px;
    }

    .whoop-dashboard .support-main {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        overflow: hidden;
    }

    .whoop-dashboard .support-value {
        flex: 0 1 auto;
        max-width: 132px;
        font-size: 50px;
        line-height: 52px;
    }

    .whoop-dashboard .support-value .unit {
        margin-left: 1px;
        font-size: 18px;
        letter-spacing: -0.02em;
    }

    .whoop-dashboard .support-summary {
        display: flex;
        flex: 1 1 auto;
        flex-direction: column;
        gap: 4px;
        overflow: hidden;
        text-align: right;
    }

    .whoop-dashboard .support-status {
        font-size: 12px;
        font-weight: 900;
        line-height: 15px;
        text-transform: uppercase;
    }

    .whoop-dashboard .support-detail {
        color: var(--muted);
        font-size: 12px;
        font-weight: 800;
        line-height: 15px;
    }

    .whoop-dashboard .support-foot {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 10px;
        overflow: hidden;
        border-top: 1px solid var(--line);
        font-size: 12px;
        font-weight: 800;
        line-height: 16px;
    }

    .whoop-dashboard .support-foot span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .whoop-dashboard .vitals-strip {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        overflow: hidden;
        border: 2px solid var(--ink);
        border-radius: 14px;
        background: var(--paper);
    }

    .whoop-dashboard .vital {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
        padding: 10px 14px;
        overflow: hidden;
    }

    .whoop-dashboard .vital + .vital::before {
        position: absolute;
        top: 12px;
        bottom: 12px;
        left: 0;
        width: 1px;
        background: var(--line);
        content: "";
    }

    .whoop-dashboard .vital-label,
    .whoop-dashboard .vital-value {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .whoop-dashboard .vital-label {
        color: var(--muted);
        font-size: 12px;
        font-weight: 900;
        line-height: 14px;
        text-transform: uppercase;
    }

    .whoop-dashboard .vital-value {
        font-size: 20px;
        font-weight: 900;
        line-height: 22px;
    }

    .whoop-dashboard .small-unit {
        margin-left: 2px;
        font-size: 12px;
        font-weight: 800;
    }

    .whoop-dashboard .empty-value {
        letter-spacing: 0;
    }
</style>

{% assign local_updated = last_updated | date: "%s" | plus: trmnl.user.utc_offset %}
<div class="view whoop-dashboard">
    <header class="header">
        <div class="logo">WHOOP</div>
        <div class="sync-meta truncate">
            {{ local_updated | date: "%a, %b %d" }} &middot; Synced {{ local_updated | date: "%H:%M" }}
        </div>
    </header>

    <main class="main-grid">
        <section class="card recovery-card">
            <h2 class="section-label">Today's readiness</h2>

            <div class="recovery-summary">
                {% if recovery_score %}
                <div class="hero-value">{{ recovery_score | round }}<span class="unit">%</span></div>
                <div class="recovery-copy">
                    <div class="recovery-status truncate">{{ recovery_status | default: "Recovery scored" }}</div>
                    <div class="recovery-guidance truncate">{{ recovery_guidance | default: "Review today's recovery" }}</div>
                    {% if recovery_delta %}
                    <div class="comparison truncate">
                        {% if recovery_delta > 0 %}+{% endif %}{{ recovery_delta }} vs 7-day avg
                    </div>
                    {% endif %}
                </div>
                {% else %}
                <div class="hero-value empty-value">--</div>
                <div class="recovery-copy">
                    <div class="recovery-status truncate">Not scored yet</div>
                    <div class="recovery-guidance truncate">Waiting for today's data</div>
                </div>
                {% endif %}
            </div>

            <div class="trend">
                <div class="trend-heading">
                    <span class="truncate">Recovery trend</span>
                    <span class="muted truncate">7 days &rarr; today</span>
                </div>
                <div class="history-bars">
                    {% for score in recent_recoveries %}
                    {% assign bounded_score = score | at_least: 0 | at_most: 100 %}
                    <div class="bar-column{% if forloop.last %} today{% endif %}">
                        <div class="bar-track">
                            <div class="bar" style="height: {{ bounded_score }}%"></div>
                        </div>
                        <div class="bar-caption">{% if forloop.last %}Today{% else %}{{ forloop.index }}{% endif %}</div>
                    </div>
                    {% else %}
                    <div class="comparison truncate">No recovery history available</div>
                    {% endfor %}
                </div>
            </div>
        </section>

        <div class="support-column">
            <section class="card support-card">
                <h2 class="section-label">Strain</h2>
                <div class="support-main">
                    {% if strain %}
                    <div class="support-value">{{ strain }}</div>
                    <div class="support-summary">
                        <div class="support-status truncate">{{ strain_status | default: "Today's strain" }}</div>
                        {% if strain_delta %}
                        <div class="support-detail truncate">
                            {% if strain_delta > 0 %}+{% endif %}{{ strain_delta }} vs avg
                        </div>
                        {% endif %}
                    </div>
                    {% else %}
                    <div class="support-value empty-value">--</div>
                    <div class="support-summary">
                        <div class="support-status truncate">No strain yet</div>
                    </div>
                    {% endif %}
                </div>
                <div class="support-foot">
                    <span>7-day avg</span>
                    <span>{{ weekly_strain_avg | default: "--" }}</span>
                </div>
            </section>

            <section class="card support-card">
                <h2 class="section-label">Sleep</h2>
                <div class="support-main">
                    {% if sleep_performance %}
                    <div class="support-value">{{ sleep_performance | round }}<span class="unit">%</span></div>
                    <div class="support-summary">
                        <div class="support-status truncate">{{ sleep_status | default: "Sleep scored" }}</div>
                        <div class="support-detail truncate">{{ sleep_time | default: "--" }} asleep</div>
                    </div>
                    {% else %}
                    <div class="support-value empty-value">--</div>
                    <div class="support-summary">
                        <div class="support-status truncate">Not scored yet</div>
                        <div class="support-detail truncate">Waiting for sleep data</div>
                    </div>
                    {% endif %}
                </div>
                <div class="support-foot">
                    <span>Efficiency</span>
                    <span>{% if sleep_efficiency %}{{ sleep_efficiency }}%{% else %}--{% endif %}</span>
                </div>
            </section>
        </div>
    </main>

    <footer class="vitals-strip">
        <div class="vital">
            <span class="vital-label">HRV</span>
            <span class="vital-value">{% if hrv %}{{ hrv }}<span class="small-unit">ms</span>{% else %}--{% endif %}</span>
        </div>
        <div class="vital">
            <span class="vital-label">Resting HR</span>
            <span class="vital-value">{% if resting_heart_rate %}{{ resting_heart_rate }}<span class="small-unit">bpm</span>{% else %}--{% endif %}</span>
        </div>
        <div class="vital">
            <span class="vital-label">SpO&#8322;</span>
            <span class="vital-value">{% if spo2 %}{{ spo2 }}<span class="small-unit">%</span>{% else %}--{% endif %}</span>
        </div>
        <div class="vital">
            <span class="vital-label">Skin temp</span>
            <span class="vital-value">{% if skin_temp %}{{ skin_temp }}<span class="small-unit">&deg;C</span>{% else %}--{% endif %}</span>
        </div>
        <div class="vital">
            <span class="vital-label">Resp. rate</span>
            <span class="vital-value">{% if respiratory_rate %}{{ respiratory_rate }}<span class="small-unit">/min</span>{% else %}--{% endif %}</span>
        </div>
    </footer>
</div>
